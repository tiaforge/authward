# Reference Caddyfile for authgate (Phase 10).
#
# Requires Caddy v2.11.2 or newer. Caddy 2.10.0 through 2.11.1 have
# GHSA-7r4p-vjf4-gxv4: `copy_headers` leaves a client-supplied header in
# place when the auth response doesn't carry that header, so a client
# could inject its own X-Auth-User. authgate defends in depth by
# always sending all three X-Auth-* headers (empty when there's nothing
# to forward) on every 200, but run a patched Caddy regardless.
# Verified against Caddy v2.11.4.
#
# Two site blocks per base domain: one for the auth subdomain itself
# (reverse-proxied straight to authgate, no forward_auth wrapper —
# it hosts /login, /callback, /logout, /healthz, / directly), and one
# per protected app (forward_auth in front of the real backend).
#
# IMPORTANT — trust boundary: authgate trusts X-Forwarded-Host and,
# when forward_identity_headers is enabled for a host, forwards
# X-Auth-User/X-Auth-Email/X-Auth-Groups based on it. Both this Caddy
# instance and every backend app it proxies to MUST be unreachable
# except through this Caddyfile's own network path — if a backend app is
# directly reachable from anywhere else, a client can send its own
# X-Auth-* headers straight to the backend and they'll never pass
# through copy_headers' overwrite. Put Caddy and the backends on an
# internal network (a Docker network, a private VPC, loopback-only
# binds) with no other route in.

auth.example.com {
	reverse_proxy localhost:8080
}

app.example.com {
	forward_auth localhost:8080 {
		uri /verify

		# Copies the verified identity onto the backend request. Keep
		# this line even for hosts with forward_identity_headers = false:
		# authgate sends the headers empty in that case, and copying
		# them is what overwrites (rather than passes through) any
		# X-Auth-* header the client sent.
		copy_headers X-Auth-User X-Auth-Email X-Auth-Groups

		# forward_auth does NOT redirect on a non-2xx response by
		# default — it aborts and relays the auth response's status/body
		# verbatim to the client. That's exactly what we want for a 403
		# (authgate's own "not authorized" page) and a 502 (its
		# "misconfigured host" page), but a 401 ("not authenticated")
		# needs to become a redirect to /login instead. authgate's
		# 401 carries the exact login URL to use in X-Login-Url, with the
		# original request URL query-encoded inside `rd` — don't rebuild
		# it here as `...?rd={scheme}://{host}{uri}`: {uri} goes in raw,
		# so an `&` in the original query string truncates rd.
		@denied status 401
		handle_response @denied {
			redir * {http.reverse_proxy.header.X-Login-Url} 302
		}
	}

	reverse_proxy localhost:9000 {
		# Strip authgate's session cookie before the request reaches the
		# backend. The cookie is Domain=.example.com so the browser sends
		# it to every app under the base domain, and a backend that sees
		# it could replay it as a single sign-on session against every
		# sibling app. No backend ever needs it: identity arrives in the
		# X-Auth-* headers above. The two patterns cover the cookie in
		# the middle/end and at the start of the Cookie header; other
		# cookies pass through untouched.
		header_up Cookie ";\s*authgate_session=[^;]*" ""
		header_up Cookie "^authgate_session=[^;]*;?\s*" ""
	}
}
